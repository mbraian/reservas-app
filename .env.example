# ==============================================================================
# CONTRATO DE VARIABLES DE ENTORNO — RESERVAS-APP
# Copiar este archivo a .env y definir los valores reales antes de levantar:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CAPA DE ALMACENAMIENTO: reservas-db (MySQL 8.4)
# Consumidas por la imagen oficial de MySQL durante su inicialización.
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=<root_password>      # Contraseña administrativa del superusuario root
MYSQL_DATABASE=<database_name>           # Nombre de la base de datos relacional a crear
MYSQL_USER=<app_user>                    # Usuario sin privilegios creado para la aplicación
MYSQL_PASSWORD=<app_password>            # Contraseña asignada al usuario de la aplicación

# ------------------------------------------------------------------------------
# 2. CAPA DE NEGOCIO: reservas-api (Node.js 20 + Express)
# Consumidas por el backend para levantar el servidor y conectar con MySQL.
# ------------------------------------------------------------------------------
PORT=<port>                              # Puerto TCP interno donde escucha Express
DB_HOST=<db_service_name>                # Nombre de host de la base (resuelto por DNS de Docker)
DB_PORT=<db_port>                        # Puerto TCP del motor MySQL
DB_NAME=<database_name>                  # Base de datos a consultar
DB_USER=<app_user>                       # Credencial de usuario para el pool de conexiones
DB_PASSWORD=<app_password>               # Contraseña de la base de datos
APP_VERSION=<version>                    # Versión semántica reportada por el endpoint /health
SEED_DEMO=<true|false>                   # Booleano: si es 'true', siembra salas de demostración

# ------------------------------------------------------------------------------
# 3. CAPA DE PRESENTACIÓN: reservas-frontend (Nginx + React SPA)
# Consumidas por el script envsubst al arranque de Nginx para configurar el proxy.
# ------------------------------------------------------------------------------
API_HOST=<api_service_name>              # Host del backend al que Nginx redirige /api/
API_PORT=<api_port>                      # Puerto interno del backend
